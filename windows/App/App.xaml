<Application x:Class="GDirect.Windows.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
 <Application.Resources>
  <SolidColorBrush x:Key="Accent" Color="#0B57D0"/>
  <Style TargetType="Button">
   <Setter Property="Padding" Value="16,10"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="MinHeight" Value="42"/><Setter Property="Foreground" Value="#23334B"/><Setter Property="Background" Value="#EDF3FA"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#0B57D0"/><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.8"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
   <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#DDE9FA"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="#F1F3F6"/><Setter Property="Foreground" Value="#727D8B"/><Setter Property="Cursor" Value="Arrow"/></Trigger></Style.Triggers>
  </Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#0B57D0"/><Setter Property="Foreground" Value="White"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#174EA6"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="#E7ECF3"/><Setter Property="Foreground" Value="#727D8B"/></Trigger></Style.Triggers></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="12,10"/><Setter Property="MinHeight" Value="42"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="BorderBrush" Value="#C9D6E6"/><Setter Property="Background" Value="White"/><Setter Property="SelectionBrush" Value="#B7D2FC"/><Style.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="#0B57D0"/></Trigger></Style.Triggers></Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#F4F7FB"/><Setter Property="Foreground" Value="#52627A"/><Setter Property="Padding" Value="14,12"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="BorderBrush" Value="#E3EAF3"/></Style>
  <Style TargetType="DataGridCell"><Setter Property="Padding" Value="14,8"/><Setter Property="BorderThickness" Value="0"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="DataGridRow"><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#24344B"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#F0F6FF"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#DCEAFF"/><Setter Property="Foreground" Value="#123A70"/></Trigger></Style.Triggers></Style>
 </Application.Resources>
</Application>
