<Window x:Class="GDirect.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="RouteShelf · 原项目核心 Windows 预览" Width="1000" Height="620" MinWidth="800" MinHeight="560" Background="#F4F7FC" Foreground="#1F2937" FontFamily="Microsoft YaHei UI" FontSize="14">
 <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="RouteShelf" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="Windows · 只读云盘客户端" Margin="0,5,0,0" Foreground="#4B5563"/></StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="ConfigButton" Content="选择桌面授权配置" Click="Configure"/><Button x:Name="LoginButton" Content="登录 Google" Click="Login" Style="{StaticResource Primary}"/><Button x:Name="LogoutButton" Content="断开" Click="Logout" IsEnabled="False"/></StackPanel>
  </Grid>
  <Border Grid.Row="1" Background="#E8F0FE" Padding="18" CornerRadius="12" Margin="0,0,0,18"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="AccountText" Text="尚未登录" FontWeight="SemiBold"/><TextBlock Text="首次授权或凭据失效时使用浏览器；日常启动通过原项目核心直连刷新登录。" Margin="0,5,12,0" TextWrapping="Wrap"/></StackPanel><Button Grid.Column="1" x:Name="CheckButton" Content="检测数据连接" Click="Check" VerticalAlignment="Center"/></Grid></Border>
  <Grid Grid.Row="2" Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="公开文件链接（无需登录）" VerticalAlignment="Center" Margin="0,0,12,0"/><TextBox Grid.Column="1" x:Name="LinkText" ToolTip="粘贴公开 Google Drive 单文件链接，无需登录" AutomationProperties.Name="公开文件分享链接"/><Button Grid.Column="2" x:Name="PublicButton" Content="通过链接下载" Click="PublicDownload" Margin="8,0,0,0"/></Grid><Grid Grid.Row="3" Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Button x:Name="BackButton" Content="上一级" Click="Back" IsEnabled="False"/><Button x:Name="HomeButton" Grid.Column="1" Content="我的云盘" Click="Home" IsEnabled="False"/><TextBox Grid.Column="2" x:Name="SearchText" ToolTip="按文件名搜索整个云盘" KeyDown="SearchKey" IsEnabled="False"/><Button Grid.Column="3" x:Name="SearchButton" Content="搜索" Margin="8,0,0,0" Click="Search" IsEnabled="False"/>
  </Grid>
  <Grid Grid.Row="4"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><TextBlock x:Name="PathText" Text="我的云盘" Margin="0,0,0,12" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
   <DataGrid Grid.Row="1" x:Name="Files" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEF2F7" VerticalScrollBarVisibility="Auto" BorderThickness="0" RowHeight="46" ColumnHeaderHeight="42" Background="White" MouseDoubleClick="OpenFolder" KeyDown="FilesKey" SelectionChanged="SelectionChanged">
    <DataGrid.Columns><DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="类型" Binding="{Binding Kind}" Width="110"/><DataGridTextColumn Header="大小" Binding="{Binding SizeText}" Width="130"/><DataGridTextColumn Header="修改时间" Binding="{Binding Modified}" Width="210"/></DataGrid.Columns>
   </DataGrid>
   <TextBlock x:Name="EmptyText" Grid.Row="1" Text="登录后浏览文件夹和下载文件" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#4B5563" IsHitTestVisible="False"/>
  </Grid>
  <StackPanel Grid.Row="5" Margin="0,18,0,0"><TextBlock x:Name="StatusText" Text="选择 Google 桌面应用 OAuth JSON，然后登录。成功授权后将由 Windows 加密保存登录凭据。" Foreground="#42536B" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/><ProgressBar x:Name="Progress" Height="4" Margin="0,10,0,12" Visibility="Collapsed"/>
   <DockPanel><StackPanel Orientation="Horizontal"><Button x:Name="RefreshButton" Content="刷新" Click="Refresh" IsEnabled="False"/><Button x:Name="MoreButton" Content="加载更多" Click="More" IsEnabled="False"/><Button x:Name="DownloadButton" Content="下载 / 导出" Click="Download" IsEnabled="False" Style="{StaticResource Primary}"/></StackPanel><Button x:Name="CancelButton" Content="取消当前操作" Click="Cancel" HorizontalAlignment="Right" IsEnabled="False"/></DockPanel>
  </StackPanel>
 </Grid>
</Window>
